# Optional: enables AI advice from Gemma via the Gemini API.
# Get a key: https://www.mlh.com/partners/gemma?utm_source=mlh&utm_medium=referral&utm_content=Best+Use+of+Gemma+4
GEMINI_API_KEY=your-api-key-here
# GEMMA_MODEL=gemma-4-26b-a4b-it

# Database. If DATABASE_URL is set (PostgreSQL, e.g. Neon), it is used.
# Otherwise a local SQLite file at DATABASE_PATH is used.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_PATH=data/assessments.db

# Protects GET /api/stats. Stats are disabled when unset.
# ADMIN_TOKEN=change-me

# Set to false to skip the Have I Been Pwned breach check (e.g. offline).
# BREACH_CHECK=true

# Server settings
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false
